# LedgerLens AI - Environment Configuration (Client-side)
# Copy this file to .env and provide your Supabase project credentials.

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (safe for client-side use with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
